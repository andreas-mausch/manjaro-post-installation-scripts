msgid ""
msgstr ""
"Language: de\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Plural-Forms: nplurals=2; plural=(n != 1);\n"

msgid "Calamares did not provide a hostname."
msgstr "Calamares hat keinen Hostnamen bereitgestellt."

msgid "The SPICE guest channel is missing."
msgstr "Der SPICE-Gastkanal fehlt."

msgid "Choose whether to copy model weights."
msgstr "Modellgewichte mit oder ohne Kopieren auswählen."

msgid "Boot the USB drive in UEFI mode; disable Secure Boot."
msgstr "Den Stick im UEFI-Modus booten; Secure Boot deaktivieren."

msgid "For this image: erase the entire SSD and select no swap."
msgstr "Für dieses Image: gesamte SSD löschen, kein Swap."

msgid "Invalid or reserved username."
msgstr "Ungültiger oder reservierter Benutzername."

msgid "Automatic login is disabled for this image."
msgstr "Automatische Anmeldung ist für dieses Image deaktiviert."

msgid "Exactly one root partition is required."
msgstr "Genau eine Root-Partition muss vorhanden sein."

msgid "/boot must be an unencrypted EFI/FAT32 partition."
msgstr "/boot muss eine unverschlüsselte EFI-/FAT32-Partition sein."

msgid "This image does not support swap."
msgstr "Dieses Image unterstützt keinen Swap."

msgid "Invalid installation mount point."
msgstr "Ungültiger Installations-Mountpoint."

msgid "Checking target mounts"
msgstr "Ziel-Mounts prüfen"

msgid "Pinned configuration is missing from the image."
msgstr "Gepinnte Konfiguration fehlt im Image."

msgid "Model weights are missing from the image."
msgstr "Modellgewichte fehlen im Image."

msgid "Preparing target configuration"
msgstr "Zielkonfiguration vorbereiten"

msgid "Generating hardware configuration"
msgstr "Hardwarekonfiguration erzeugen"

msgid "Preparing user access"
msgstr "Benutzerzugang vorbereiten"

msgid "Offline system installation"
msgstr "Offline-Systeminstallation"

msgid "System installation"
msgstr "Systeminstallation"

msgid "Copying model weights"
msgstr "Modellgewichte kopieren"

msgid "Install NixOS"
msgstr "NixOS installieren"

msgid "Copy model weights"
msgstr "Modellgewichte kopieren"

msgid "Invalid installer stage."
msgstr "Ungültige Installer-Phase."

msgid "Model copying failed"
msgstr "Modellkopie fehlgeschlagen"

msgid "NixOS has already been installed; model copying is incomplete. Do not reinstall or format the disk to retry the model copy."
msgstr "NixOS wurde bereits installiert; die Modellkopie ist unvollständig. Für einen erneuten Kopierversuch nicht neu installieren oder den Datenträger formatieren."

msgid "Preflight checks"
msgstr "Vorprüfung"

msgid "Preparing system installation"
msgstr "Systeminstallation vorbereiten"

msgid "Subprocess"
msgstr "Unterprozess"

msgid "System installation command failed (exit code {code})."
msgstr "Systeminstallationsaufruf fehlgeschlagen (Exit-Code {code})."

msgid "{program} failed (exit code {code})."
msgstr "{program} fehlgeschlagen (Exit-Code {code})."

msgid "Operating system error (errno {errno})."
msgstr "Betriebssystemfehler (errno {errno})."

msgid "The target disk has already been partitioned; installation is incomplete. Do not reinstall or format again without checking the disk first."
msgstr "Der Zieldatenträger wurde bereits partitioniert; die Installation ist unvollständig. Nicht ohne Prüfung erneut installieren oder formatieren."

msgid "Preflight checks failed before partitioning."
msgstr "Die Vorprüfung wurde vor dem Partitionierungsjob abgebrochen."

msgid "NixOS installation failed"
msgstr "NixOS-Installation fehlgeschlagen"

msgid "Phase: {phase}. {detail}"
msgstr "Phase: {phase}. {detail}"

msgid "Original diagnostics: Calamares output or in the live terminal:"
msgstr "Originaldiagnostik: Calamares-Ausgabe oder im Live-Terminal:"

msgid "Check the first error before subsequent errors. Review logs for sensitive data before sharing; no automatic upload."
msgstr "Die erste Fehlermeldung vor den Folgefehlern prüfen. Protokolle vor Weitergabe auf sensible Daten prüfen; kein automatischer Upload."
msgid "Copying {count} model files: {bytes} bytes ({gib:.2f} GiB) to {target}"
msgstr "Kopiere {count} Modelldateien: {bytes} Bytes ({gib:.2f} GiB) nach {target}"

msgid "Copying {name}: {bytes} bytes ({gib:.2f} GiB) to {target}"
msgstr "Kopiere {name}: {bytes} Bytes ({gib:.2f} GiB) nach {target}"

msgid "Model copying completed: {bytes} bytes in {count} files."
msgstr "Modellkopie abgeschlossen: {bytes} Bytes in {count} Dateien."
msgid "Invalid model directory."
msgstr "Ungültiges Modellverzeichnis."
msgid "Model copy: {copied:.2f} / {total:.2f} GiB ({rate:.1f} MiB/s)"
msgstr "Modellkopie: {copied:.2f} / {total:.2f} GiB ({rate:.1f} MiB/s)"
