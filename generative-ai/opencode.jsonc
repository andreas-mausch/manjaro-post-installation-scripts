{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "plugins": [
    "opencode-models-discovery@v1.10.0"
  ],
  "instructions": [
    "~/.config/opencode/personal/personal-profile-protocol.md"
  ],
  "permission": {
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow"
    },
    "edit": "allow",
    "glob": "allow",
    "grep": "allow",
    "bash": {
      "*": "ask",
      "git status *": "allow",
      "git diff *": "allow",
      "git log *": "allow",
      "git branch *": "allow",
      "git show *": "allow",
      "git ls-files *": "allow",
      "git rev-parse *": "allow",
      "git describe *": "allow",
      "git tag *": "allow",
      "git remote *": "allow",
      "git stash list *": "allow",
      "git for-each-ref *": "allow",
      "git worktree list *": "allow",
      "ls *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "find *": "allow",
      "grep *": "allow",
      "rg *": "allow",
      "wc *": "allow",
      "unzip *": "allow",
      "pwd": "allow",
      "whoami": "allow",
      "echo *": "allow",
      "date": "allow",
      "test *": "allow",
      "javap *": "allow",
      "mvn *": "allow",
      "git push *": "deny"
    },
    "task": "allow",
    "skill": "allow",
    "lsp": "allow",
    "question": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "external_directory": {
      "*": "ask",
      "~/.config/opencode/personal/*": "allow"
    },
    "doom_loop": "ask"
  },
  "command": {
    "kommunikationsfeedback": {
      "description": "Persönliches Kommunikationsprofil gemeinsam auswerten und aktualisieren",
      "template": "Lies ~/.config/opencode/personal/personal-profile.md und ~/.config/opencode/personal/personal-observations.md. Führe mit mir eine Feedback-Runde zu meiner Persönlichkeit und Kommunikation durch. Benenne Stärken, Schwächen, wiederkehrende Muster, Veränderungen und mögliche Fehlinterpretationen konkret und ehrlich. Trenne meine Selbstaussagen von deinen Beobachtungen. Frage bei wichtigen Unklarheiten nach. Aktualisiere anschließend das Profil anhand unserer gemeinsamen Ergebnisse und markiere die verwendeten Beobachtungen als ausgewertet. Zusätzlicher Schwerpunkt: $ARGUMENTS"
    }
  },
  "providers": {
    "gaming-desktop": {
      "package": "@opencode-ai/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "http://gaming-desktop:1235/v1",
        "apiKey": "${LLM_GAMING_DESKTOP_API_KEY}",
        "modelsDiscovery": {
          "enabled": true
        }
      },
      "models": {
        "Qwen3.6-35B-A3B": {
          "id": "Qwen3.6-35B-A3B-Uncensored-HauhauCS-Aggressive-IQ4_XS.gguf",
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          },
          "limit": {
            "context": 131072,
            "output": 16000
          }
        }
      }
    }
  }
}
